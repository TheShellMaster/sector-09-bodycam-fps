; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="SECTOR 09 // BODYCAM"
config/description="FPS tactique photoréaliste en vue Bodycam natif Linux"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.0313726, 0.0392157, 0.0509804, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=false
config/icon="res://assets/icon.png"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

